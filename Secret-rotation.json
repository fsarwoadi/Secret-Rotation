{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "triggers": {
      "Every_three_days": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 3,
          "timeZone": "UTC"
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Init_Applications": {
        "type": "InitializeVariable",
        "runAfter": {},
        "description": "One entry per app registration. appId = Application (client) ID; the new secret is written to keyVaultName/secretName.",
        "inputs": {
          "variables": [
            {
              "name": "applications",
              "type": "array",
              "value": [
                {
                  "appId": "<APP-1-CLIENT-ID-GUID>",
                  "keyVaultName": "<KEY-VAULT-NAME>",
                  "secretName": "app1-client-secret",
                  "cyberArkVariableId": "data/rotated-secrets/app1-client-secret"
                },
                {
                  "appId": "<APP-2-CLIENT-ID-GUID>",
                  "keyVaultName": "<KEY-VAULT-NAME>",
                  "secretName": "app2-client-secret",
                  "cyberArkVariableId": "data/rotated-secrets/app2-client-secret"
                }
              ]
            }
          ]
        }
      },
      "Init_CyberArk_Config": {
        "type": "InitializeVariable",
        "runAfter": { "Init_Applications": [ "Succeeded" ] },
        "description": "CyberArk Secrets Manager (Conjur) settings. The login and API key are read from the Azure Key Vault below.",
        "inputs": {
          "variables": [
            {
              "name": "cyberArk",
              "type": "object",
              "value": {
                "url": "https://<CYBERARK-SECRETS-MANAGER-HOST>",
                "account": "<CYBERARK-ACCOUNT-NAME>",
                "credentialsKeyVaultName": "<KEY-VAULT-NAME-HOLDING-CYBERARK-CREDENTIALS>",
                "loginSecretName": "cyberark-login",
                "apiKeySecretName": "cyberark-api-key"
              }
            }
          ]
        }
      },
      "Get_CyberArk_login": {
        "type": "Http",
        "runAfter": { "Init_CyberArk_Config": [ "Succeeded" ] },
        "inputs": {
          "method": "GET",
          "uri": "https://@{variables('cyberArk')['credentialsKeyVaultName']}.vault.azure.net/secrets/@{variables('cyberArk')['loginSecretName']}?api-version=7.4",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://vault.azure.net"
          }
        },
        "runtimeConfiguration": {
          "secureData": { "properties": [ "outputs" ] }
        }
      },
      "Get_CyberArk_API_key": {
        "type": "Http",
        "runAfter": { "Get_CyberArk_login": [ "Succeeded" ] },
        "inputs": {
          "method": "GET",
          "uri": "https://@{variables('cyberArk')['credentialsKeyVaultName']}.vault.azure.net/secrets/@{variables('cyberArk')['apiKeySecretName']}?api-version=7.4",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://vault.azure.net"
          }
        },
        "runtimeConfiguration": {
          "secureData": { "properties": [ "outputs" ] }
        }
      },
      "For_each_app": {
        "type": "Foreach",
        "runAfter": { "Get_CyberArk_API_key": [ "Succeeded" ] },
        "foreach": "@variables('applications')",
        "runtimeConfiguration": {
          "concurrency": { "repetitions": 5 }
        },
        "actions": {
          "Add_new_client_secret": {
            "type": "Http",
            "runAfter": {},
            "description": "Creates a new secret valid for 7 days (overlaps the 3-day cycle so consumers can pick up the new value).",
            "inputs": {
              "method": "POST",
              "uri": "https://graph.microsoft.com/v1.0/applications(appId='@{items('For_each_app')?['appId']}')/addPassword",
              "headers": { "Content-Type": "application/json" },
              "body": {
                "passwordCredential": {
                  "displayName": "@{concat('logicapp-rotated-', formatDateTime(utcNow(), 'yyyyMMddHHmm'))}",
                  "endDateTime": "@{addDays(utcNow(), 7)}"
                }
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com"
              }
            },
            "runtimeConfiguration": {
              "secureData": { "properties": [ "outputs" ] }
            }
          },
          "Store_secret_in_Key_Vault": {
            "type": "Http",
            "runAfter": { "Add_new_client_secret": [ "Succeeded" ] },
            "inputs": {
              "method": "PUT",
              "uri": "https://@{items('For_each_app')?['keyVaultName']}.vault.azure.net/secrets/@{items('For_each_app')?['secretName']}?api-version=7.4",
              "headers": { "Content-Type": "application/json" },
              "body": {
                "value": "@{body('Add_new_client_secret')?['secretText']}",
                "attributes": {
                  "enabled": true,
                  "exp": "@div(sub(ticks(body('Add_new_client_secret')?['endDateTime']), ticks('1970-01-01T00:00:00Z')), 10000000)"
                },
                "tags": {
                  "appId": "@{items('For_each_app')?['appId']}",
                  "keyId": "@{body('Add_new_client_secret')?['keyId']}",
                  "rotatedBy": "logic-app"
                }
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://vault.azure.net"
              }
            },
            "runtimeConfiguration": {
              "secureData": { "properties": [ "inputs", "outputs" ] }
            }
          },
          "Authenticate_to_CyberArk": {
            "type": "Http",
            "runAfter": { "Store_secret_in_Key_Vault": [ "Succeeded" ] },
            "description": "Conjur API-key authentication; returns a short-lived access token (about 8 minutes), so it is requested per app.",
            "inputs": {
              "method": "POST",
              "uri": "@{variables('cyberArk')['url']}/authn/@{encodeUriComponent(variables('cyberArk')['account'])}/@{encodeUriComponent(body('Get_CyberArk_login')?['value'])}/authenticate",
              "headers": { "Content-Type": "text/plain" },
              "body": "@body('Get_CyberArk_API_key')?['value']"
            },
            "runtimeConfiguration": {
              "secureData": { "properties": [ "inputs", "outputs" ] }
            }
          },
          "Store_secret_in_CyberArk": {
            "type": "Http",
            "runAfter": { "Authenticate_to_CyberArk": [ "Succeeded" ] },
            "inputs": {
              "method": "POST",
              "uri": "@{variables('cyberArk')['url']}/secrets/@{encodeUriComponent(variables('cyberArk')['account'])}/variable/@{encodeUriComponent(items('For_each_app')?['cyberArkVariableId'])}",
              "headers": {
                "Content-Type": "text/plain",
                "Authorization": "Token token=\"@{base64(string(body('Authenticate_to_CyberArk')))}\""
              },
              "body": "@body('Add_new_client_secret')?['secretText']"
            },
            "runtimeConfiguration": {
              "secureData": { "properties": [ "inputs", "outputs" ] }
            }
          },
          "Get_application": {
            "type": "Http",
            "runAfter": { "Store_secret_in_CyberArk": [ "Succeeded" ] },
            "inputs": {
              "method": "GET",
              "uri": "https://graph.microsoft.com/v1.0/applications(appId='@{items('For_each_app')?['appId']}')?$select=id,passwordCredentials",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com"
              }
            }
          },
          "Filter_expired_rotated_secrets": {
            "type": "Query",
            "runAfter": { "Get_application": [ "Succeeded" ] },
            "description": "Only expired secrets created by this playbook; other secrets are never touched.",
            "inputs": {
              "from": "@body('Get_application')?['passwordCredentials']",
              "where": "@and(startsWith(coalesce(item()?['displayName'], ''), 'logicapp-rotated-'), less(ticks(item()?['endDateTime']), ticks(utcNow())), not(equals(item()?['keyId'], body('Add_new_client_secret')?['keyId'])))"
            }
          },
          "Remove_expired_secrets": {
            "type": "Foreach",
            "runAfter": { "Filter_expired_rotated_secrets": [ "Succeeded" ] },
            "foreach": "@body('Filter_expired_rotated_secrets')",
            "runtimeConfiguration": {
              "concurrency": { "repetitions": 1 }
            },
            "actions": {
              "Remove_password": {
                "type": "Http",
                "runAfter": {},
                "inputs": {
                  "method": "POST",
                  "uri": "https://graph.microsoft.com/v1.0/applications/@{body('Get_application')?['id']}/removePassword",
                  "headers": { "Content-Type": "application/json" },
                  "body": { "keyId": "@items('Remove_expired_secrets')?['keyId']" },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com"
                  }
                }
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "parameters": {}
}
